post_install() {
    echo ""
    echo "==> pam_tgbot установлен: /usr/lib/security/pam_tgbot.so"
    echo ""
    echo "──── Шаг 1. Добавьте [pam] секцию в /etc/tgbot/config.toml ────"
    echo ""
    echo "    [pam]"
    echo "    enabled                 = true"
    echo "    notify_login            = true"
    echo "    two_factor_enabled      = false   # true для полной 2FA"
    echo "    two_factor_timeout_secs = 60"
    echo "    block_ip_cmd            = \"ban-cs\"  # команда из [[commands]]"
    echo ""
    echo "──── Шаг 2. Добавьте в /etc/pam.d/sshd ────"
    echo ""
    echo "  Только уведомления (безопасный вариант для начала):"
    echo "    session  optional  pam_tgbot.so"
    echo ""
    echo "  С 2FA (auth — добавлять ПОСЛЕ pam_unix.so / publickey):"
    echo "    auth     required  pam_tgbot.so"
    echo "    session  optional  pam_tgbot.so"
    echo ""
    echo "  ВАЖНО: перед включением 2FA убедитесь, что у вас есть"
    echo "  резервный доступ к консоли или через другого пользователя."
    echo ""
    echo "──── Шаг 3. Разрешите завершение сессий через sudo ────"
    echo ""
    echo "    echo 'tgbot ALL=(ALL) NOPASSWD: /usr/bin/loginctl' \\"
    echo "        | sudo tee /etc/sudoers.d/tgbot-pam"
    echo "    sudo chmod 440 /etc/sudoers.d/tgbot-pam"
    echo ""
    echo "──── Напоминание ────"
    echo "  Бот (tgbot.service) должен быть запущен для работы 2FA."
    echo "  При остановленном боте 2FA пропускается (fail-open)."
    echo ""
}

post_upgrade() {
    echo ""
    echo "==> pam_tgbot обновлён."
    echo "    Проверьте наличие секции [pam] в /etc/tgbot/config.toml."
    echo ""
}
