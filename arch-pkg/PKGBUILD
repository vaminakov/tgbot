# Maintainer: Vladislav Minakov <v@minakov.pro>

pkgname=tgbot
pkgver=1.2.1
pkgrel=1
pkgdesc="Telegram bot for server management — written in Rust"
arch=('x86_64')
url="https://gitlab.minakov.pro/vaminakov/tgbot"
makedepends=('rust' 'pam')
depends=('pam')
license=('MIT')
install=tgbot.install
backup=('etc/tgbot/config.toml')
source=("tgbot.sysusers"
        "tgbot.tmpfiles"
        "tgbot.install")
sha512sums=('SKIP'
            'SKIP'
            'SKIP')

build() {
  cd "$startdir/.."
  cargo build --release

  cd "$startdir/../pam_tgbot"
  cargo build --release
}

package() {
  cd "$startdir/.."

  # Main bot binary
  install -Dm755 "target/release/tgbot" \
                 "$pkgdir/usr/bin/tgbot"

  # PAM module (.so): Rust emits libpam_tgbot.so, PAM expects pam_tgbot.so
  install -Dm755 "pam_tgbot/target/release/libpam_tgbot.so" \
                 "$pkgdir/usr/lib/security/pam_tgbot.so"

  # systemd / sysusers / tmpfiles
  install -Dm644 "systemd/tgbot.service"   "$pkgdir/usr/lib/systemd/system/tgbot.service"
  install -Dm644 "$srcdir/tgbot.sysusers"  "$pkgdir/usr/lib/sysusers.d/tgbot.conf"
  install -Dm644 "$srcdir/tgbot.tmpfiles"  "$pkgdir/usr/lib/tmpfiles.d/tgbot.conf"

  # Default config (backup= prevents pacman from overwriting it on upgrade)
  install -Dm640 "config.example.toml"     "$pkgdir/etc/tgbot/config.toml"

  # License
  install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
